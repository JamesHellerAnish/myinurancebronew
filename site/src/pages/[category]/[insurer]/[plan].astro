---
// The plan page. SEO_ASTRO_PLAN.md §8 — the anti-thin-content contract, blocks 1–12 in order.
//
// §2.1 lesson 4: Perfecplan generated 4,000 pages against a template nobody had looked at,
// and 21 CSS classes had no rules for two sessions. This is the one template to build end
// to end and inspect before anything is generated at scale.
//
// Paths come from publishablePlans() — never getCollection('plans') directly. See lib/plans.ts.
import type { GetStaticPaths } from 'astro'
import Base from '../../../layouts/Base.astro'
import Disclaimer from '../../../components/seo/Disclaimer.astro'
import {
  publishablePlans,
  planPath,
  categoryPath,
  siblingPlans,
  CATEGORY_LABELS,
  type Plan,
} from '../../../lib/plans'
import { breadcrumbSchema, faqSchema, planSchema } from '../../../lib/schema'
import { fitDescription, fitTitle } from '../../../lib/seo'
import { complaintsPhrase } from '../../../lib/format'
import profiles from '../../../data/profiles.json'

export const getStaticPaths = (async () => {
  const plans = await publishablePlans()

  return plans.map((plan) => ({
    params: {
      category: categoryPath(plan.data.category),
      insurer: plan.data.insurerSlug,
      plan: plan.data.slug,
    },
    props: { plan },
  }))
}) satisfies GetStaticPaths

interface Props {
  plan: Plan
}

const { plan } = Astro.props
const d = plan.data

const categoryLabel = CATEGORY_LABELS[d.category]
const categoryUrl = `/${categoryPath(d.category)}/`
const url = planPath(plan)
const siblings = await siblingPlans(plan)

// Premium rows. profiles.json only defines term and health today; the five Tier A
// categories have no profile set yet, so the table is omitted rather than rendered empty.
const profileSet = (profiles as Record<string, { assumption: string; rows: Array<{ key: string; label: string }> }>)[
  d.category
]
const premiumRows = profileSet?.rows.filter((row) => d.premiums[row.key] != null) ?? []

// §16.4 — Ditto's plan header includes a "Download Policy Info" button; ours points at
// whichever source is the actual policy document rather than a marketing product page.
const policyDocSource =
  d.sources.find((s) => !/product page/i.test(s.label)) ?? d.sources[0]

/**
 * True where a figure has not been confirmed against a primary source, so the template can
 * mark it "TBD" beside the value. §11 — an unsourced number must not be presented as though
 * it were sourced, and a marker on the figure itself is more honest than a block of prose at
 * the bottom of the page that nobody reads next to the number it is about.
 */
const tbd = (field: string) => d.unverifiedFields.includes(field)

const rupee = new Intl.NumberFormat('en-IN', {
  style: 'currency',
  currency: 'INR',
  maximumFractionDigits: 0,
})

// §8 block 3 — the answer block. 40–60 words, directly answering the page's query. The
// single highest-leverage block for featured snippets and AI citation (§10.4).
const answer =
  `${d.insurer} ${d.name} scores ${d.score}/5 in our assessment. ` +
  `${d.insurer} settles ${d.metrics.csr}% of claims and draws ` +
  `${complaintsPhrase(d.metrics.complaints)} per 10,000 claims. ` +
  (d.coverRange ? `Cover runs ${d.coverRange}. ` : '') +
  (premiumRows.length > 0
    ? `Illustrative premiums start at ${rupee.format(Math.min(...premiumRows.map((r) => d.premiums[r.key])))} a year.`
    : '')

// §8 block 8 — FAQs, templated per variable. §16.4: open with a bare Yes/No where the
// question is a yes/no question, because that is what gets extracted.
const faqs = [
  {
    q: `Is ${d.insurer} ${d.name} a good plan?`,
    a:
      `We score it ${d.score} out of 5. ${d.verdict}`,
  },
  {
    q: `What is the claim settlement ratio of ${d.insurer}?`,
    a:
      `${d.metrics.csr}%, as a three-year average for FY 2024–26 from IRDAI disclosures. ` +
      `${d.insurer} receives ${complaintsPhrase(d.metrics.complaints)} per 10,000 claims.`,
  },
  ...(d.coverRange
    ? [
        {
          q: `How much cover can I take under ${d.name}?`,
          a: `${d.coverRange}.${d.entryAge ? ` Entry age is ${d.entryAge}.` : ''}`,
        },
      ]
    : []),
  {
    q: `What does ${d.name} not cover?`,
    a: `The main exclusions are: ${d.notCovered.join('; ')}.`,
  },
]

// The insurer crumb is deliberately absent. /[category]/companies/[insurer]/ is not built
// yet (§6.2), and a breadcrumb is worse than a normal dead link: it also goes into the
// BreadcrumbList JSON-LD, so a 404 gets published as structured data. Restore the crumb in
// one line here when the insurer pages ship.
const trail = [
  { name: 'Home', path: '/' },
  { name: categoryLabel, path: categoryUrl },
  { name: d.name, path: url },
]

// §8.1 — bare page title. The brand suffix is added by title() and nowhere else.
// Candidates run longest-first: fitTitle() takes the most informative one that still fits
// under 60 chars with the brand suffix. "Aditya Birla Sun Life Super Term Plan" needs the
// short name; "SBI General Super Health Platinum Infinite" needs to lose "Review" as well.
const insurerShort = d.insurerShort ?? d.insurer
const pageTitle = fitTitle([
  `${d.insurer} ${d.name} Review`,
  `${insurerShort} ${d.name} Review`,
  `${insurerShort} ${d.name}`,
])

// §9.2 — 150–160 chars, and lead with the numbers so they survive if a SERP truncates.
const description = fitDescription(
  `${insurerShort} ${d.name} scored ${d.score}/5. ${d.insurer} settles ${d.metrics.csr}% of ` +
    `claims, with ${complaintsPhrase(d.metrics.complaints)} per 10,000.`,
  [
    'Features, exclusions and indicative premiums.',
    'Cover, exclusions and indicative premiums.',
    'Cover, exclusions and premiums.',
    'Cover and exclusions.',
    'Full review.',
  ],
)
---

<Base
  title={pageTitle}
  description={description}
  modified={d.lastVerified}
  keywords={[
    `${d.insurer} ${d.name}`,
    `${d.name} review`,
    `${d.name} vs`,
    `${d.insurer} claim settlement ratio`,
    categoryLabel.toLowerCase(),
  ]}
  schemas={[
    breadcrumbSchema(trail),
    faqSchema(faqs),
    planSchema(plan, url),
  ]}
>
  <article class="plan-page is-branded" style={d.accent ? `--plan-accent: ${d.accent};` : undefined}>
    {/* 1. Breadcrumbs */}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {trail.map((crumb, i) => (
          <li>
            {i < trail.length - 1 ? (
              <a href={crumb.path}>{crumb.name}</a>
            ) : (
              <span aria-current="page">{crumb.name}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    {/* 2. H1 — unique, no brand suffix. The insurer's own logo and brand colour sit with it:
        the reader arrived looking for a specific insurer's plan, so showing whose plan this is
        is orientation, not decoration. The accent is applied through --plan-accent (set on the
        article below) so one custom property drives every accented element on the page. */}
    <header class="plan-header">
      {d.logo && (
        <span class="plan-header-logo">
          <img
            src={`/assets/logos/${d.logo}`}
            alt={`${d.insurer} logo`}
            width="56"
            height="56"
            loading="eager"
            decoding="async"
          />
        </span>
      )}
      <div>
        <span class="plan-header-insurer">{d.insurer}</span>
        <h1>{d.name} review</h1>
      </div>
      <span class="plan-header-score" aria-label={`Our score: ${d.score} out of 5`}>
        <strong>{d.score}</strong><span>/ 5</span>
      </span>
    </header>
    {d.subtitle && <p class="plan-subtitle">{d.subtitle}</p>}

    {/* 3. Answer block */}
    <p class="answer-block">{answer}</p>

    {/* §16.4 — the "Download Policy Info" button from Ditto's plan-header spec. Links to the
        actual policy document (wording or brochure) on the insurer's own site, not a copy
        hosted here — we are an advisor, not the document's publisher. */}
    {policyDocSource && (
      <p class="policy-doc-link">
        <a href={policyDocSource.url} class="btn btn-outline" rel="nofollow noopener" target="_blank">
          View policy document on {d.insurer}'s website ↗
        </a>
      </p>
    )}

    {/* 4. Key facts — machine-readable pairs. A "TBD" marker means that figure is not yet
        confirmed against a primary source (see unverifiedFields on the record). */}
    <dl class="key-facts">
      <div><dt>Our score</dt><dd>{d.score} / 5</dd></div>
      <div>
        <dt>Claim settlement ratio</dt>
        <dd>{d.metrics.csr}%{tbd('metrics.csr') && <span class="tbd" title="Not yet confirmed against a primary source">TBD</span>}</dd>
      </div>
      <div>
        <dt>Complaints per 10,000 claims</dt>
        <dd>{d.metrics.complaints}{tbd('metrics.complaints') && <span class="tbd" title="Not yet confirmed against a primary source">TBD</span>}</dd>
      </div>
      {d.coverRange && (
        <div>
          <dt>Cover available</dt>
          <dd>{d.coverRange}{tbd('coverRange') && <span class="tbd" title="Not yet confirmed against a primary source">TBD</span>}</dd>
        </div>
      )}
      {d.entryAge && (
        <div>
          <dt>Entry age</dt>
          <dd>{d.entryAge}{tbd('entryAge') && <span class="tbd" title="Not yet confirmed against a primary source">TBD</span>}</dd>
        </div>
      )}
      {d.tenure && (
        <div>
          <dt>Term</dt>
          <dd>{d.tenure}{tbd('tenure') && <span class="tbd" title="Not yet confirmed against a primary source">TBD</span>}</dd>
        </div>
      )}
      {d.roomRent && (
        <div>
          <dt>Room rent limit</dt>
          <dd>{d.roomRent}{tbd('roomRent') && <span class="tbd" title="Not yet confirmed against a primary source">TBD</span>}</dd>
        </div>
      )}
      {d.waiting?.ped != null && (
        <div>
          <dt>Pre-existing disease wait</dt>
          <dd>{d.waiting.ped} years{tbd('waiting.ped') && <span class="tbd" title="Not yet confirmed against a primary source">TBD</span>}</dd>
        </div>
      )}
    </dl>

    {/* 5. Main content */}
    <section>
      <h2>What {d.name} covers</h2>
      <ul>{d.covered.map((item) => <li>{item}</li>)}</ul>

      <h2>Key features</h2>
      <ul>{d.features.map((item) => <li>{item}</li>)}</ul>

      {d.riders.length > 0 && (
        <>
          <h2>Riders and add-ons</h2>
          <ul>{d.riders.map((item) => <li>{item}</li>)}</ul>
        </>
      )}

      {/* §16.4 — "What's Missing" as a named section. Naming the weaknesses is the trust
          play, and it maps onto notCovered[]. */}
      <h2>What {d.name} does not cover</h2>
      <ul>{d.notCovered.map((item) => <li>{item}</li>)}</ul>
    </section>

    {/* 6. A real <table> — never a div grid, never an image */}
    {premiumRows.length > 0 && (
      <section>
        <h2>What does {d.name} cost?</h2>
        <p class="table-assumption">{profileSet.assumption}</p>
        <div class="table-scroll">
          <table>
            <caption>
              Indicative annual premiums for {d.insurer} {d.name}. Illustrations, not quotes.
            </caption>
            <thead>
              <tr><th scope="col">Profile</th><th scope="col">Annual premium</th></tr>
            </thead>
            <tbody>
              {premiumRows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td>{rupee.format(d.premiums[row.key])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* 7. Pros / cons — both populated */}
    <section class="pros-cons">
      <div>
        <h2>What we like</h2>
        <ul>{d.pros.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2>What we don't</h2>
        <ul>{d.cons.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    <section>
      <h2>Our verdict</h2>
      <p>{d.verdict}</p>
      <p class="methodology-link">
        Every score resolves to <a href="/methodology/">how we score plans</a> —
        plan features 45%, insurer strength 45%, premium 10%.
      </p>
    </section>

    {/* 8. FAQ */}
    <section>
      <h2>Frequently asked questions</h2>
      {faqs.map((faq) => (
        <details>
          <summary><h3>{faq.q}</h3></summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </section>

    {/* 9. Sources + last verified — feeds dateModified */}
    <section class="sources">
      <h2>Sources</h2>
      {d.sources.length > 0 ? (
        <ul>
          {d.sources.map((source) => (
            <li>
              <a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a>
              {source.clause && <span class="clause"> — {source.clause}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p>Source documents are being verified for this plan.</p>
      )}
      {d.lastVerified && (
        <p class="last-verified">
          Last verified <time datetime={d.lastVerified.toISOString()}>
            {d.lastVerified.toLocaleDateString('en-IN', { dateStyle: 'long' })}
          </time>
        </p>
      )}
      {/* Figures not yet confirmed against a primary source are marked "TBD" beside the value
          itself rather than described in a block here — see unverifiedFields on the record.
          verificationNote is kept in the data as the provenance trail, but is internal: it
          records how each figure was checked, which is a working note, not page copy. */}
      {d.unverifiedFields.length > 0 && (
        <p class="tbd-legend">
          <span class="tbd">TBD</span> marks a figure we have not yet confirmed against the
          insurer's own policy document. We publish it because it is our current best
          understanding, and we flag it because it is not yet sourced.
        </p>
      )}
    </section>

    {/* 11. Internal links — the mesh (§9.3). Without this, pages are orphans. */}
    <section class="internal-links">
      <h2>Compare {d.name} with other {categoryLabel.toLowerCase()} plans</h2>
      <ul>
        {siblings.map((sibling) => (
          <li><a href={planPath(sibling)}>{sibling.data.insurer} {sibling.data.name}</a></li>
        ))}
      </ul>
      {/* Only routes that exist. /[category]/best-plans/ and the insurer pages are still
          unbuilt (§6.2); linking them from every plan page would publish 404s at scale. */}
      <p>
        <a href={categoryUrl}>All {categoryLabel.toLowerCase()} plans</a> ·
        <a href="/methodology/">How we score plans</a>
      </p>
    </section>

    {/* 10. CTA — the existing booking form. Field names are frozen (CLAUDE.md invariant 1). */}
    <section class="plan-cta">
      <h2>Not sure if this is the right plan for you?</h2>
      <p>Talk to a licensed advisor. No spam, no sales pressure.</p>
      <form action="/send-mail.php" method="post">
        <input type="hidden" name="product" value={`${d.insurer} ${d.name}`} />
        <label>Name <input type="text" name="name" required /></label>
        <label>Phone <input type="tel" name="phone" required /></label>
        <label>Email <input type="email" name="email" required /></label>
        <label>Preferred time <input type="text" name="preferred_time" /></label>
        <button type="submit">Request a callback</button>
      </form>
    </section>

    {/* 12. Disclaimer */}
    <Disclaimer />
  </article>
</Base>
