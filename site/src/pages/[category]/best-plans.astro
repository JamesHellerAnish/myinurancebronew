---
// /[category]/best-plans/ — the Ditto-style flagship. SEO_ASTRO_PLAN.md §6.2.
//
// This is the highest-intent page in the category and the one most likely to be quoted by an
// AI assistant, so it has to do the thing a listicle usually refuses to do: commit. Every
// pick is named, ranked, and justified against a figure, and the runner-up is named too.
//
// §13: "best" is a comparative claim under IRDAI advertising rules. Every superlative on
// this page resolves to /methodology/ and is stated with the pool it was computed over —
// "highest of the N plans we have reviewed", never "India's best".
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import Disclaimer from '../../components/seo/Disclaimer.astro'
import {
  publishablePlans,
  plansByCategory,
  planPath,
  categoryPath,
  CATEGORY_LABELS,
  type Plan,
  type PlanCategory,
} from '../../lib/plans'
import { breadcrumbSchema, faqSchema } from '../../lib/schema'
import { fitDescription, fitTitle } from '../../lib/seo'
import { complaintsPhrase } from '../../lib/format'
import profiles from '../../data/profiles.json'
import meta from '../../data/meta.json'

export const getStaticPaths = (async () => {
  const plans = await publishablePlans()
  const categories = [...new Set(plans.map((p) => p.data.category))]

  return Promise.all(
    categories.map(async (category) => ({
      params: { category: categoryPath(category) },
      props: { category, plans: await plansByCategory(category) },
    })),
  )
}) satisfies GetStaticPaths

interface Props {
  category: PlanCategory
  plans: Plan[]
}

const { category, plans } = Astro.props
const label = CATEGORY_LABELS[category]
const lower = label.toLowerCase()
const categoryUrl = `/${categoryPath(category)}/`

const rupee = new Intl.NumberFormat('en-IN', {
  style: 'currency',
  currency: 'INR',
  maximumFractionDigits: 0,
})

const profileSet = (profiles as Record<string, { assumption: string; rows: Array<{ key: string; label: string }> }>)[
  category
]

function entryPremium(plan: Plan): number | null {
  const values = (profileSet?.rows ?? [])
    .map((row) => plan.data.premiums[row.key])
    .filter((v): v is number => v != null)
  return values.length > 0 ? Math.min(...values) : null
}

// The awards. Each is computed from the data rather than asserted, so they cannot drift from
// the tables further down the page, and each carries the figure that won it.
const byScore = [...plans]
const bestCsr = [...plans].sort((a, b) => b.data.metrics.csr - a.data.metrics.csr)[0]
const fewestComplaints = [...plans].sort(
  (a, b) => a.data.metrics.complaints - b.data.metrics.complaints,
)[0]
const cheapest = [...plans]
  .filter((p) => entryPremium(p) != null)
  .sort((a, b) => (entryPremium(a) ?? 0) - (entryPremium(b) ?? 0))[0]

const overall = byScore[0]
const runnerUp = byScore[1]

const awards = [
  overall && {
    title: 'Best overall',
    plan: overall,
    why: `Highest score of the ${plans.length} we have reviewed, at ${overall.data.score}/5.`,
  },
  bestCsr && {
    title: 'Best claim record',
    plan: bestCsr,
    why: `${bestCsr.data.insurer} settles ${bestCsr.data.metrics.csr}% of claims — the highest here.`,
  },
  fewestComplaints &&
    fewestComplaints.id !== bestCsr?.id && {
      title: 'Fewest complaints',
      plan: fewestComplaints,
      why: `${complaintsPhrase(fewestComplaints.data.metrics.complaints)} per 10,000 claims, the lowest here.`,
    },
  cheapest && {
    title: 'Cheapest to start',
    plan: cheapest,
    why: `Illustrative premiums from ${rupee.format(entryPremium(cheapest) ?? 0)} a year.`,
  },
].filter(Boolean) as Array<{ title: string; plan: Plan; why: string }>

const trail = [
  { name: 'Home', path: '/' },
  { name: label, path: categoryUrl },
  { name: 'Best plans', path: `${categoryUrl}best-plans/` },
]

const faqs = [
  {
    q: `Which is the best ${lower} plan in India?`,
    a:
      `Of the ${plans.length} plans we have reviewed, ${overall.data.insurer} ` +
      `${overall.data.name} scores highest at ${overall.data.score}/5. ${overall.data.verdict}`,
  },
  {
    q: `Is the highest-scoring plan the right one for me?`,
    a:
      'Not necessarily. A score ranks plans on the evidence available; it cannot know your ' +
      'health history, your dependants or which exclusion will matter to you. Use it to ' +
      'shortlist, then read the policy wording.',
  },
  {
    q: `Do you get paid to rank these ${lower} plans?`,
    a:
      'No insurer can pay for inclusion, for a higher rank, or to have a weakness removed. ' +
      'We earn a standard commission on policies placed through us, disclosed rather than ' +
      'hidden — which is why the scores are computed from published data.',
  },
]

const pageTitle = fitTitle([
  `Best ${label} Plans in India`,
  `Best ${label} Plans`,
  `Best ${label}`,
])

const description = fitDescription(
  `${overall.data.insurer} ${overall.data.name} leads our ${lower} ranking at ` +
    `${overall.data.score}/5, from ${plans.length} plans scored on cover and claims.`,
  ['Picks for claims, price and cover.', 'Independent and unpaid.'],
)
---

<Base
  title={pageTitle}
  description={description}
  current={category}
  keywords={[
    `best ${lower} plan India`,
    `top ${lower} plans`,
    `which ${lower} to buy`,
    `${lower} comparison`,
  ]}
  schemas={[breadcrumbSchema(trail), faqSchema(faqs)]}
>
  <article class="plan-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={categoryUrl}>{label}</a></li>
        <li><span aria-current="page">Best plans</span></li>
      </ol>
    </nav>

    <h1>The best {lower} plans in India</h1>
    <p class="plan-subtitle">
      Ranked on claim record and policy wording. We name one winner, and say who it is not for.
    </p>

    <p class="answer-block">
      {overall.data.insurer} {overall.data.name} is our top {lower} pick, scoring
      {' '}{overall.data.score}/5 across the {plans.length} plans we have reviewed.
      {runnerUp && ` ${runnerUp.data.insurer} ${runnerUp.data.name} is the runner-up at ${runnerUp.data.score}/5.`}
      {' '}{bestCsr.data.insurer} has the strongest claim record here at
      {' '}{bestCsr.data.metrics.csr}%, {meta.period.toLowerCase()} from IRDAI disclosures.
    </p>

    <section>
      <h2>Our picks</h2>
      <div class="award-grid">
        {awards.map((award) => (
          <div class="award">
            <span class="award-title">{award.title}</span>
            <h3><a href={planPath(award.plan)}>{award.plan.data.insurer} {award.plan.data.name}</a></h3>
            <p>{award.why}</p>
          </div>
        ))}
      </div>
      <p class="methodology-link">
        Each award is computed from the data on this page, not chosen by hand —
        <a href="/methodology/">how we score plans</a>.
      </p>
    </section>

    <section>
      <h2>All {plans.length} plans, ranked</h2>
      <div class="table-scroll">
        <table>
          <caption>
            Sorted by our score. {profileSet ? profileSet.assumption : ''}
          </caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Plan</th>
              <th scope="col">Score</th>
              <th scope="col">CSR</th>
              <th scope="col">Complaints<span class="th-note"> per 10,000</span></th>
              {cheapest && <th scope="col">From</th>}
            </tr>
          </thead>
          <tbody>
            {plans.map((plan, i) => (
              <tr>
                <td>{i + 1}</td>
                <th scope="row" class="cell-prose">
                  <a href={planPath(plan)}>{plan.data.insurer} {plan.data.name}</a>
                </th>
                <td>{plan.data.score} / 5</td>
                <td>{plan.data.metrics.csr}%</td>
                <td>{plan.data.metrics.complaints}</td>
                {cheapest && (
                  <td>
                    {entryPremium(plan) != null ? rupee.format(entryPremium(plan) ?? 0) : '—'}
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Why each plan is here — and who it is not for</h2>
      {plans.map((plan) => (
        <div class="verdict-block">
          <h3><a href={planPath(plan)}>{plan.data.insurer} {plan.data.name}</a></h3>
          <p>{plan.data.verdict}</p>
          {plan.data.cons.length > 0 && (
            <p class="verdict-against">
              <strong>Against it:</strong> {plan.data.cons[0]}
            </p>
          )}
        </div>
      ))}
    </section>

    <section>
      <h2>Frequently asked questions</h2>
      {faqs.map((faq) => (
        <details>
          <summary><h3>{faq.q}</h3></summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </section>

    <section class="internal-links">
      <h2>Go deeper</h2>
      <ul>
        {plans.map((plan) => (
          <li><a href={planPath(plan)}>{plan.data.insurer} {plan.data.name} review</a></li>
        ))}
      </ul>
      <p>
        <a href={`${categoryUrl}companies/`}>All {lower} companies</a> ·
        <a href={categoryUrl}>All {lower} plans</a> ·
        <a href="/methodology/">How we score</a>
      </p>
    </section>

    <Disclaimer />
  </article>
</Base>
