---
// SEO_ASTRO_PLAN.md §4.2 — the shell every page renders into.
//
// The design system ports as-is (§1.5): css/style.css + css/components.css are copied into
// public/ by scripts/sync-public.mjs and linked here, so there is one stylesheet source of
// truth shared with the legacy site rather than a fork that drifts.
import SEO from '../components/seo/SEO.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { organizationSchema } from '../lib/schema'

interface Props {
  title: string
  description: string
  brand?: boolean
  keywords?: string[]
  noindex?: boolean
  modified?: Date
  /** Extra JSON-LD blocks beyond the sitewide Organization. */
  schemas?: Array<Record<string, unknown>>
  /** Nav item to mark as current. */
  current?: string
}

const { schemas = [], current, ...seo } = Astro.props
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Applies the saved theme before first paint. This has to be inline and blocking:
         deferred, the page paints light and then flips, which is worse than not having a
         toggle. Same `mib-theme` key as js/main.js, so a preference set on the legacy
         one-pager carries over to the generated pages during the migration. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('mib-theme')
        if (t) document.documentElement.setAttribute('data-theme', t)
      } catch (e) {}
    </script>

    <SEO {...seo} />

    <!-- TODO(§9.1): self-host Inter and Space Grotesk to kill these two round-trips.
         Leaving the CDN link for now so the port renders identically to the legacy site;
         swapping it is a CWV task, not a correctness one. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <!-- The Astro-only layer: long-form content pages. The legacy one-pager does not link
         it, so style.css and components.css stay shared rather than forked. -->
    <link rel="stylesheet" href="/css/pages.css" />

    <JsonLd schema={organizationSchema()} />
    {schemas.map((schema) => <JsonLd schema={schema} />)}
  </head>

  <body>
    <Header current={current} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
