---
// SEO_ASTRO_PLAN.md §12 step 3 — ported from index.html:1591. Classes match the legacy
// markup exactly so style.css styles it unchanged.
//
// §9.3: the footer is sitewide internal linking, so every href here has to resolve. The
// legacy footer is full of `href="#"` placeholders (Motor, Travel, Articles, Careers…) —
// those are dead links on a one-pager and would become 404s repeated on ~2,900 pages here.
// This version lists only what exists, and grows as routes ship.
import { getCollection } from 'astro:content'
import { CATEGORY_LABELS, categoryPath, publishablePlans } from '../lib/plans'

const YEAR = new Date().getFullYear()

// 2026-09-11: pages now publish regardless of verificationStatus (see lib/plans.ts) — this
// list is really "which categories exist at all", not a verification gate any more.
const published = await publishablePlans()
const liveCategories = (['health', 'term'] as const).filter((key) =>
  published.some((plan) => plan.data.category === key),
)
const products = liveCategories.map((key) => ({
  href: `/${categoryPath(key)}/`,
  label: CATEGORY_LABELS[key],
}))
// §9.3 internal-linking mesh — best-plans and companies exist per live category and were
// missing from the footer's site map.
const bestPlans = liveCategories.map((key) => ({
  href: `/${categoryPath(key)}/best-plans/`,
  label: `Best ${CATEGORY_LABELS[key]} plans`,
}))
const companies = liveCategories.map((key) => ({
  href: `/${categoryPath(key)}/companies/`,
  label: `${CATEGORY_LABELS[key]} companies`,
}))

const personas = (await getCollection('personas')).map((p) => ({
  href: `/for/${p.data.key}/`,
  label: p.data.label,
}))
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img
            src="/assets/images/my-insurance-bro-logo.png"
            alt="Myinsurancebro"
            width="134"
            height="136"
            loading="lazy"
            decoding="async"
          />
          <span>Myinsurancebro</span>
        </div>
        <p class="footer-tagline">
          Your trusted insurance advisory partner. We compare, you choose — with zero spam and
          lifetime support.
        </p>
        <p class="footer-parent">A product by Myinsurancebro Advisory LLP</p>
      </div>

      <div>
        <h4>Products</h4>
        <ul>
          {products.map((product) => (
            <li><a href={product.href}>{product.label}</a></li>
          ))}
          {bestPlans.map((page) => (
            <li><a href={page.href}>{page.label}</a></li>
          ))}
          {companies.map((page) => (
            <li><a href={page.href}>{page.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Resources</h4>
        <ul>
          <li><a href="/methodology/">How we score plans</a></li>
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/glossary/">Insurance glossary</a></li>
          <li><a href="/llms.txt">Data for AI assistants</a></li>
          {personas.map((persona) => (
            <li><a href={persona.href}>For: {persona.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/#advisor">About us</a></li>
          <li><a href="/#cta">Contact us</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-legal">
        {/* §11: the licence line is a regulated claim. It is reproduced verbatim from
            index.html and must not be reworded or extended here. */}
        IRDAI Registered Corporate Agent (Composite) · License No. CA0001 · Valid till 2027<br />
        © {YEAR} Myinsurancebro Advisory LLP. All Rights Reserved.
      </div>
    </div>
  </div>
</footer>
