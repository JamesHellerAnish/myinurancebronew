---
// Section 3b — the comparison engine, in its short home-page form.
//
// SEO_ASTRO_PLAN.md §12 step 10 and §1.2: the engine stays a client-rendered island
// (js/compare.js fills #cmpGrid, #cmpMatrixHost and the rest at runtime), but the plans it
// compares must ALSO exist as static HTML — client-rendered content is the single biggest
// SEO defect on the current site, and shipping the same hole into the rebuild would defeat
// the point of the migration. So #cmpGrid is server-rendered with a real <table>;
// compare.js overwrites its innerHTML on hydration.
//
// What this section no longer carries, and where it went. The home page was running four
// long blocks below the fold — the premium illustration table, the insurer league table and
// the full scoring methodology — each of which already has a page of its own that ranks for
// its own query. Duplicating them here made the home page long without making any of them
// easier to find, so they are now three links out. The hosts are simply absent, which
// js/compare.js treats as a no-op (see the "Optional hosts" note there).
//
// The deep-dive panel stays: its hosts are empty divs with no visual weight until a visitor
// presses "Full review" on a plan card, and removing them would break that button.
//
// The rows come from publishablePlans(), the same verification gate as every plan page — so
// an unverified figure cannot be published here either.
import { publishablePlans, planPath, categoryPath, CATEGORY_LABELS } from '../../lib/plans'
import Disclaimer from '../seo/Disclaimer.astro'

const plans = (await publishablePlans()).sort((a, b) => b.data.score - a.data.score)

// The static table is the crawlable fallback, not the experience — six rows is enough to
// show what the section is, and the category hubs below carry the rest.
const TOP_N = 6
const topPlans = plans.slice(0, TOP_N)

// Only hubs that actually have published plans, same gate as the nav and footer.
const hubs = (['term', 'health'] as const)
  .filter((key) => plans.some((plan) => plan.data.category === key))
  .map((key) => ({
    href: `/${categoryPath(key)}/best-plans/`,
    label: CATEGORY_LABELS[key],
    count: plans.filter((plan) => plan.data.category === key).length,
  }))
---

<section class="section-padding cmp section-alt" id="compare">
  <div class="container">
    <div class="section-header fade-up">
      <span class="eyebrow"><svg class="icon"><use href="#i-scale"></use></svg> Compare on the real numbers</span>
      <h2>Every plan, <span class="highlight">side by side</span></h2>
      <p>Claim settlement, complaints and waiting periods — from IRDAI disclosures, not brochures.</p>
    </div>

    <div class="cmp-toolbar">
      <div class="segmented ink" role="tablist" aria-label="Choose a product">
        <button type="button" role="tab" data-product="term" aria-selected="true">
          <svg class="icon"><use href="#i-shield"></use></svg> Term Life
        </button>
        <button type="button" role="tab" data-product="health" aria-selected="false" tabindex="-1">
          <svg class="icon"><use href="#i-heart-pulse"></use></svg> Health
        </button>
      </div>

      <div class="segmented" role="tablist" aria-label="Choose a view">
        <button type="button" role="tab" data-mode="explore" aria-selected="true">
          <svg class="icon"><use href="#i-sliders"></use></svg> Explore
        </button>
        <button type="button" role="tab" data-mode="compare" aria-selected="false" tabindex="-1">
          <svg class="icon"><use href="#i-layers"></use></svg> Compare
        </button>
        <button type="button" role="tab" data-mode="deepdive" aria-selected="false" tabindex="-1">
          <svg class="icon"><use href="#i-search"></use></svg> Deep dive
        </button>
      </div>
    </div>

    <!-- ── Mode: Explore ────────────────────────────── -->
    <div class="cmp-panel active" id="cmpExplore">
      <div class="cmp-filters" id="cmpFilters"></div>
      <div class="cmp-grid" id="cmpGrid">
        {/* Replaced by compare.js on hydration — see the note above. */}
        {topPlans.length > 0 && (
          <div class="table-scroll">
            <table>
              <caption>
                Top {topPlans.length} by score. Premiums are indicative illustrations, never quotes.
              </caption>
              <thead>
                <tr>
                  <th scope="col">Plan</th>
                  <th scope="col">Score</th>
                  <th scope="col">Claim settlement</th>
                </tr>
              </thead>
              <tbody>
                {topPlans.map((plan) => (
                  <tr>
                    <th scope="row">
                      {/* The insurer mark, so the fallback scans as a list of companies
                          rather than a wall of names. `logo` carries the filename with its
                          extension; the monogram is the documented fallback where an
                          insurer has no file — CLAUDE.md invariant 5. alt is empty because
                          the insurer's name is the next thing read. */}
                      <span class={plan.data.logo ? 'monogram has-logo' : 'monogram'}>
                        {plan.data.logo ? (
                          <img
                            class="brand-logo"
                            src={`/assets/logos/${plan.data.logo}`}
                            alt=""
                            width="28"
                            height="28"
                            loading="lazy"
                          />
                        ) : (
                          plan.data.monogram
                        )}
                      </span>
                      <a href={planPath(plan)}>{plan.data.insurer} {plan.data.name}</a>
                    </th>
                    <td>{plan.data.score} / 5</td>
                    <td>{plan.data.metrics.csr}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>

    <!-- ── Mode: Compare ────────────────────────────── -->
    <div class="cmp-panel" id="cmpCompare">
      <div id="cmpMatrixHost"></div>
    </div>

    <!-- ── Mode: Deep dive ──────────────────────────── -->
    <div class="cmp-panel" id="cmpDeepdive">
      <div class="cmp-deepdive-picker" id="cmpDeepPicker"></div>
      <div id="cmpDeepBody"></div>
    </div>

    {/* The three blocks that used to sit here, as three links. Each target is a page that
        already carries the full version. */}
    <div class="cmp-more stagger">
      {hubs.map((hub) => (
        <a class="cmp-more-card" href={hub.href}>
          <span class="icon-tile sm"><svg class="icon"><use href="#i-bar-chart"></use></svg></span>
          <span class="cmp-more-text">
            <strong>Best {hub.label}</strong>
            <span>All {hub.count} plans, ranked</span>
          </span>
          <span class="arrow">→</span>
        </a>
      ))}
      <a class="cmp-more-card" href="/methodology/">
        <span class="icon-tile sm teal"><svg class="icon"><use href="#i-scale"></use></svg></span>
        <span class="cmp-more-text">
          <strong>How we score</strong>
          <span>The weights, and the premium illustrations</span>
        </span>
        <span class="arrow">→</span>
      </a>
      <a class="cmp-more-card" href="/guides/">
        <span class="icon-tile sm warm"><svg class="icon"><use href="#i-file-text"></use></svg></span>
        <span class="cmp-more-text">
          <strong>Guides</strong>
          <span>Room rent, waiting periods, claim ratios</span>
        </span>
        <span class="arrow">→</span>
      </a>
    </div>

    <div class="section-cta fade-up">
      <p>Want this narrowed to the two or three that fit you? That is a ten-minute call.</p>
      <div class="section-cta-actions">
        <a href="#cta" class="btn btn-primary">Get a quotation</a>
        <a href="tel:+919910963123" class="btn btn-outline">Call advisor today</a>
      </div>
    </div>

    <Disclaimer />
  </div>

  <!-- Sticky selection tray -->
  <div class="cmp-tray" id="cmpTray" role="region" aria-live="polite" aria-label="Plans selected for comparison">
    <span class="cmp-tray-count" id="cmpTrayCount"></span>
    <div class="cmp-tray-chips" id="cmpTrayChips"></div>
    <button type="button" class="btn btn-primary btn-sm" id="cmpTrayGo">Compare</button>
  </div>
</section>
