---
// Section 3b — the comparison engine. Ported from index.html:662.
//
// SEO_ASTRO_PLAN.md §12 step 10 and §1.2: the engine itself stays a client-rendered island
// (js/compare.js fills #cmpGrid, #cmpMatrixHost and the rest at runtime), but the plans it
// compares must ALSO exist as static HTML — client-rendered content is the single biggest
// SEO defect on the current site, and shipping the same hole into the rebuild would defeat
// the point of the migration.
//
// So #cmpGrid is server-rendered with a real <table>. compare.js overwrites its innerHTML
// on hydration, so a visitor with JavaScript sees the interactive cards exactly as today,
// and a crawler without it sees a genuine table of the same figures.
//
// The rows come from publishablePlans(), the same verification gate as every plan page —
// so an unverified figure cannot be published here either. While nothing is verified this
// renders no rows, and the interactive engine still works from js/policy-data.js, exactly
// as it does on the live site today.
import { publishablePlans, planPath, CATEGORY_LABELS } from '../../lib/plans'
import { complaintsPhrase } from '../../lib/format'

const plans = (await publishablePlans()).sort((a, b) => b.data.score - a.data.score)
---

    <section class="section-padding cmp section-alt" id="compare">
      <div class="container">
        <div class="section-header fade-up">
          <span class="eyebrow"><svg class="icon"><use href="#i-scale"></use></svg> Compare on the real numbers</span>
          <h2>Every plan, <span class="highlight">side by side</span></h2>
          <p>Claim settlement ratios, complaint volumes, waiting periods and premiums for the plans we actually
            recommend — sourced from IRDAI disclosures and insurer policy wordings, not brochures.</p>
        </div>

        <div class="cmp-toolbar">
          <div class="segmented ink" role="tablist" aria-label="Choose a product">
            <button type="button" role="tab" data-product="term" aria-selected="true">
              <svg class="icon"><use href="#i-shield"></use></svg> Term Life
            </button>
            <button type="button" role="tab" data-product="health" aria-selected="false" tabindex="-1">
              <svg class="icon"><use href="#i-heart-pulse"></use></svg> Health
            </button>
          </div>

          <div class="segmented" role="tablist" aria-label="Choose a view">
            <button type="button" role="tab" data-mode="explore" aria-selected="true">
              <svg class="icon"><use href="#i-sliders"></use></svg> Explore
            </button>
            <button type="button" role="tab" data-mode="compare" aria-selected="false" tabindex="-1">
              <svg class="icon"><use href="#i-layers"></use></svg> Compare
            </button>
            <button type="button" role="tab" data-mode="deepdive" aria-selected="false" tabindex="-1">
              <svg class="icon"><use href="#i-search"></use></svg> Deep dive
            </button>
          </div>
        </div>

        <!-- ── Mode: Explore ────────────────────────────── -->
        <div class="cmp-panel active" id="cmpExplore">
          <div class="cmp-filters" id="cmpFilters"></div>
          <div class="cmp-grid" id="cmpGrid">
            {/* Replaced by compare.js on hydration — see the note above. */}
            {plans.length > 0 && (
              <div class="table-scroll">
                <table>
                  <caption>
                    Plans we recommend, scored. Premiums are indicative illustrations for a
                    stated profile, never quotes.
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Plan</th>
                      <th scope="col">Type</th>
                      <th scope="col">Score</th>
                      <th scope="col">Claim settlement</th>
                      <th scope="col">Complaints per 10,000 claims</th>
                    </tr>
                  </thead>
                  <tbody>
                    {plans.map((plan) => (
                      <tr>
                        <th scope="row">
                          <a href={planPath(plan)}>{plan.data.insurer} {plan.data.name}</a>
                        </th>
                        <td>{CATEGORY_LABELS[plan.data.category]}</td>
                        <td>{plan.data.score} / 5</td>
                        <td>{plan.data.metrics.csr}%</td>
                        <td>{complaintsPhrase(plan.data.metrics.complaints)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        </div>

        <!-- ── Mode: Compare ────────────────────────────── -->
        <div class="cmp-panel" id="cmpCompare">
          <div id="cmpMatrixHost"></div>
        </div>

        <!-- ── Mode: Deep dive ──────────────────────────── -->
        <div class="cmp-panel" id="cmpDeepdive">
          <div class="cmp-deepdive-picker" id="cmpDeepPicker"></div>
          <div id="cmpDeepBody"></div>
        </div>

        <!-- ── Premium illustrations ────────────────────── -->
        <div class="cmp-subsection">
          <h3>What it actually costs</h3>
          <p class="sub" id="cmpPremiumNote"></p>
          <div id="cmpPremiumHost"></div>
        </div>

        <!-- ── Insurer league table ─────────────────────── -->
        <div class="cmp-subsection">
          <h3>Insurer league table</h3>
          <p class="sub">The plan matters, but the company behind it decides whether your claim gets paid. These are the
            insurers ranked on their own track record.</p>
          <div id="cmpLeagueHost"></div>
        </div>

        <!-- ── Methodology ──────────────────────────────── -->
        <div class="cmp-subsection">
          <h3>How we score plans</h3>
          <p class="sub">No insurer pays us for a higher rank. Here is exactly what goes into a score, and what each
            part is worth.</p>
          <div id="cmpMethodHost"></div>
        </div>

        <!-- ── Disclaimer ───────────────────────────────── -->
        <div class="policy-disclaimer fade-up">
          <p><strong><svg class="icon"><use href="#i-alert-triangle"></use></svg> Disclaimer:</strong> Figures shown
            here are compiled from IRDAI annual reports and public grievance disclosures, and from insurer public
            disclosures and policy wordings. Claim settlement ratios and complaint volumes are three-year averages for
            FY 2024–26. <strong>Premiums are indicative illustrations for the stated profile, not quotes</strong> — your
            actual premium depends on your age, health, city, habits and underwriting. Scores are Myinsurancebro's own
            assessment. Always read the official policy document and speak to an advisor before buying.
            Myinsurancebro is an IRDAI-licensed insurance advisor — we do not manufacture or underwrite any insurance
            product.</p>
        </div>
      </div>

      <!-- Sticky selection tray -->
      <div class="cmp-tray" id="cmpTray" role="region" aria-live="polite" aria-label="Plans selected for comparison">
        <span class="cmp-tray-count" id="cmpTrayCount"></span>
        <div class="cmp-tray-chips" id="cmpTrayChips"></div>
        <button type="button" class="btn btn-primary btn-sm" id="cmpTrayGo">Compare</button>
      </div>
    </section>
