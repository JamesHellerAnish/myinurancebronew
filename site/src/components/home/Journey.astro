---
// Section 5 — Others vs us, across the three stages of buying a policy.
//
// Ported from index.html:1180 and rewritten from 18 hand-written <li> blocks into data.
// Two reasons. The markup was the same seven elements repeated eighteen times, so a change
// to the row structure meant eighteen edits. And every row carried a full sentence after
// the bold lead-in — 18 sentences in a section a visitor is meant to scan down two columns,
// which is why this was the longest block on the page. The lead-in already says it; the
// tail is now a short clause or nothing at all.
//
// js/main.js binds .journey-tab by data-tab and toggles .active on #panel-<tab>, so the
// ids and class names are unchanged.
//
// The panels carry NO .fade-up, and it must not come back. A panel is display:none until
// its tab is clicked, so an IntersectionObserver never reports it as intersecting and it
// never receives .visible — tabs 2 and 3 opened to an empty box at opacity 0. The panel
// already has its own reveal: .journey-panel.active runs the fadeIn keyframe in style.css,
// which is the right mechanism for a tab switch.
interface Stage {
  key: string
  tab: string
  others: { subtitle: string; points: Array<[string, string]> }
  brand: { subtitle: string; points: Array<[string, string]> }
}

const stages: Stage[] = [
  {
    key: 'shortlisting',
    tab: 'Shortlisting',
    others: {
      subtitle: 'Generic & commission-driven',
      points: [
        ['One-size-fits-all push', 'no look at your health or finances'],
        ['Commission bias', 'the plan that pays the agent most'],
        ['Fine print left unread', 'sub-limits and room-rent caps stay buried'],
      ],
    },
    brand: {
      subtitle: 'Personalised & unbiased',
      points: [
        ['A real conversation first', 'your family, income and liabilities'],
        ['The whole market compared', 'shortlisted on published numbers'],
        ['No sales pressure', 'benefits and waiting periods in plain English'],
      ],
    },
  },
  {
    key: 'application',
    tab: 'Application & Payment',
    others: {
      subtitle: 'Stressful & error-prone',
      points: [
        ['No form guidance', 'medical questions left to you'],
        ['High rejection risk', 'a missed disclosure surfaces years later'],
        ['Hidden costs', 'add-ons appearing at checkout'],
      ],
    },
    brand: {
      subtitle: 'Guided & transparent',
      points: [
        ['Step by step', 'application through to payment'],
        ['Disclosures double-checked', 'the part that decides a contested claim'],
        ['Priced in the open', 'premium, terms and riders before you pay'],
      ],
    },
  },
  {
    key: 'issuance',
    tab: 'Policy Issuance',
    others: {
      subtitle: 'Abandoned after the sale',
      points: [
        ['Gone once paid', 'calls stop being returned'],
        ['Unverified channels', 'documents from an address you cannot check'],
        ['No claim help', 'the hospital desk, alone, on the worst day'],
      ],
    },
    brand: {
      subtitle: 'Official issuance, lifetime contact',
      points: [
        ['Documents from the insurer', "direct from the company's own address"],
        ['Still here at renewal', 'changes, questions and top-ups'],
        ['Lifetime claim management', 'we file, follow up and escalate'],
      ],
    },
  },
]
---

<section class="journey section-padding" id="journey">
  <div class="container">
    <div class="section-header fade-up">
      <h2>Your Insurance Journey —<br>Others vs <span class="highlight">My Insurance Bro</span></h2>
      <p>The same three stages, done two different ways.</p>
    </div>

    <div class="journey-tabs fade-up">
      {stages.map((stage, i) => (
        <button
          class={`journey-tab${i === 0 ? ' active' : ''}`}
          data-tab={stage.key}
          id={`tab${stage.key.charAt(0).toUpperCase()}${stage.key.slice(1)}`}
        >
          {stage.tab}
        </button>
      ))}
    </div>

    {stages.map((stage, i) => (
      <div class={`journey-panel${i === 0 ? ' active' : ''}`} id={`panel-${stage.key}`}>
        <div class="journey-comparison">
          <div class="journey-col others">
            <div class="journey-col-header">
              <div class="badge">👎</div>
              <div>
                <h4>Traditional Brokers & Others</h4>
                <span class="col-subtitle">{stage.others.subtitle}</span>
              </div>
            </div>
            <ul class="journey-list">
              {stage.others.points.map(([lead, tail]) => (
                <li>
                  <span class="icon">✕</span>
                  <div><strong>{lead}</strong> — {tail}</div>
                </li>
              ))}
            </ul>
          </div>

          <div class="journey-col brand">
            <div class="journey-col-header">
              <div class="badge">👍</div>
              <div>
                <h4>The My Insurance Bro Advantage</h4>
                <span class="col-subtitle">{stage.brand.subtitle}</span>
              </div>
            </div>
            <ul class="journey-list">
              {stage.brand.points.map(([lead, tail]) => (
                <li>
                  <span class="icon">✓</span>
                  <div><strong>{lead}</strong> — {tail}</div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ))}

    <div class="section-cta fade-up">
      <p>Start on the right-hand column. It costs nothing to find out what you need.</p>
      <div class="section-cta-actions">
        <a href="#cta" class="btn btn-primary">Get a quotation</a>
        <a href="tel:+919797383797" class="btn btn-outline">Call advisor today</a>
      </div>
    </div>
  </div>
</section>
