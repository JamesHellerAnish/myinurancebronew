---
// Section 4 — the bento grid.
//
// Ported from index.html:1080. The tiles and their icons are unchanged; the copy is not.
// Each tile used to carry a two-to-four-line paragraph, seven of them stacked, which made
// the section read as an essay laid out in boxes. A bento grid is a scanning pattern — the
// heading is the message and the line under it is the proof, so each body is now one line.
//
// The long version of "how claim support works" was the one tile that genuinely needed the
// words; it links to #claim-support, which carries the four steps in full.
const tiles = [
  {
    class: 'bento-item wide ink',
    tone: '',
    icon: 'target',
    title: 'We start with what you actually need',
    body: 'Half the people who come to us need less cover than they were about to buy.',
  },
  {
    class: 'bento-item',
    tone: 'teal',
    icon: 'scale',
    title: 'Numbers, not brochures',
    body: 'Settlement ratios, complaints and waiting periods.',
  },
  {
    class: 'bento-item',
    tone: 'warm',
    icon: 'file-text',
    title: 'Wording in plain English',
    body: 'We read the exclusions out loud before you buy.',
  },
  {
    class: 'bento-item wide',
    tone: 'danger',
    icon: 'life-buoy',
    title: 'Lifetime claim support — even on a policy you bought elsewhere',
    body: 'Paperwork, pre-authorisation, insurer follow-ups, and the Ombudsman if it comes to that.',
    link: { href: '#claim-support', label: 'How claim support works' },
  },
  {
    class: 'bento-item',
    tone: '',
    icon: 'lock',
    title: 'Zero spam, ever',
    body: 'Your number is not a lead to be resold.',
  },
  {
    class: 'bento-item',
    tone: 'teal',
    icon: 'wallet',
    title: 'Free, and it stays free',
    body: 'Same premium either way — you just get an advisor with it.',
  },
  {
    class: 'bento-item wide',
    tone: 'warm',
    icon: 'calendar',
    title: 'We check in at renewal, not just at the sale',
    body: 'Marriage, a child, a home loan, parents crossing 60 — the file gets revisited.',
  },
]
---

<section class="section-padding" id="how-it-works">
  <div class="container">
    <div class="section-header fade-up">
      <h2>The <span class="highlight">My Insurance Bro</span> Experience</h2>
      <p>From the right plan to lifetime claim support.</p>
    </div>

    <div class="bento stagger">
      {tiles.map((tile) => (
        <div class={tile.class}>
          <span class={`icon-tile${tile.tone ? ` ${tile.tone}` : ''}`}>
            <svg class="icon"><use href={`#i-${tile.icon}`}></use></svg>
          </span>
          <h3>{tile.title}</h3>
          <p>{tile.body}</p>
          {tile.link && (
            <div class="experience-card-links" style="margin-top:var(--space-4)">
              <a href={tile.link.href}>{tile.link.label} <span class="arrow">→</span></a>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="section-cta fade-up">
      <p>Fifteen minutes on a call covers all seven of these for your situation.</p>
      <div class="section-cta-actions">
        <a href="#cta" class="btn btn-primary">Get a quotation</a>
        <a href="tel:+919910963123" class="btn btn-outline">Call advisor today</a>
      </div>
    </div>
  </div>
</section>
