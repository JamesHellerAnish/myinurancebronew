---
// Section 6 — reviews.
//
// Was six copies of the same nine elements. As data the cards gain a circular initial
// avatar — the quotes are otherwise six identical grey rectangles, and the only thing
// telling them apart was the name on the last line.
//
// js/main.js builds the carousel dots by counting .review-card, so the class names and the
// nesting are unchanged.
const reviews = [
  {
    quote:
      "I had no idea what term insurance was until My Insurance Bro explained it to me. The advisor spent 45 minutes on call \u2014 no rush, no push. Bought a \u20b91 Crore cover at just \u20b9780/month.",
    name: "Rajesh Mehta",
    city: "Mumbai",
  },
  {
    quote:
      "Finally, someone who speaks plain English about insurance! They compared 5 health plans for me and helped me choose the best one for my family. Zero spam calls after.",
    name: "Priya Sharma",
    city: "Delhi",
  },
  {
    quote:
      "Filed a claim for my father's surgery. My Insurance Bro handled everything \u2014 from documents to follow-ups with the insurer. Settled in 8 days. Truly lifetime support!",
    name: "Ankit Gupta",
    city: "Bangalore",
  },
  {
    quote:
      "I was skeptical about free advice, but these guys are legit. They recommended a plan that costs less than what I was already paying \u2014 with better coverage. Highly recommend!",
    name: "Sneha Patel",
    city: "Ahmedabad",
  },
  {
    quote:
      "As a first-time buyer, I was overwhelmed with options. My advisor explained everything patiently and even helped me fill out the application. Couldn't have done it without them.",
    name: "Vikram Singh",
    city: "Jaipur",
  },
  {
    quote:
      "What impressed me most was their honesty. They actually told me I didn't need a specific rider, saving me money. That's rare in this industry. Thank you, My Insurance Bro!",
    name: "Meera Krishnan",
    city: "Chennai",
  },
]

/** First letter of the given name. Enough to individuate a card; it is not identity. */
function initial(name: string) {
  return name.trim().charAt(0).toUpperCase()
}
---

    <!-- ═══════════ 6. REVIEWS / TRUST ═══════════ -->
    <section class="section-padding" id="reviews">
      <div class="container">
        <div class="trust-header fade-up">
          <h2>India's Top-Rated Insurance Advisor</h2>
          <p>From people we've helped.</p>
          <div class="trust-badge">
            <span class="google-icon">
              <svg width="24" height="24" viewBox="0 0 24 24">
                <path
                  d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
                  fill="#4285F4" />
                <path
                  d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  fill="#34A853" />
                <path
                  d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 001 12c0 1.77.42 3.44 1.18 4.93l3.66-2.84z"
                  fill="#FBBC05" />
                <path
                  d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  fill="#EA4335" />
              </svg>
            </span>
            <span class="rating">4.9</span>
            <span class="stars">★★★★★</span>
            <span>from 4,500+ reviews</span>
          </div>
        </div>

        <div class="reviews-track-wrapper fade-up" id="reviewsCarousel">
          <div class="reviews-track" id="reviewsTrack">
            {reviews.map((review) => (
              <div class="review-card">
                <div class="review-stars">★★★★★</div>
                <blockquote>"{review.quote}"</blockquote>
                <div class="review-author">
                  <span class="review-avatar" aria-hidden="true">{initial(review.name)}</span>
                  <span>{review.name} <span>· {review.city}</span></span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="carousel-controls" id="carouselControls">
          <!-- Dots generated by JS -->
        </div>

        <div class="section-cta fade-up">
          <p>Your turn. One call, no pressure, nothing to pay.</p>
          <div class="section-cta-actions">
            <a href="#cta" class="btn btn-primary">Get a quotation</a>
            <a href="tel:+919910963123" class="btn btn-outline">Call advisor today</a>
          </div>
        </div>
      </div>
    </section>
